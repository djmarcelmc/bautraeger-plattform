# Kopieren nach .env.prod und ausfüllen:  cp .env.prod.example .env.prod  (Datei nie committen!)

# Adresse der Plattform – der DNS-A-Eintrag muss auf die IP des Servers zeigen
DOMAIN=projectx.cubivivit.de
# E-Mail für Let's Encrypt (Hinweise zu ablaufenden Zertifikaten)
ACME_EMAIL=admin@cubivivit.de

# Datenbank-Passwort, z. B. erzeugen mit:  openssl rand -base64 32
POSTGRES_PASSWORD=

# Passwortschutz (bis zur Microsoft-Anmeldung). Hash erzeugen mit:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'IhrPasswort'
# WICHTIG: Hash in einfache Anführungszeichen setzen, sonst werden die $-Zeichen ersetzt.
BASIC_AUTH_USER=bautraeger
BASIC_AUTH_HASH='$2a$14$ersetzen'

# Aufbewahrung der täglichen Sicherungen in Tagen
BACKUP_TAGE=14

# ---------------------------------------------------------------- E-Mail-Versand (optional)
# Ohne diese Angaben werden Benachrichtigungen nur im Postausgang protokolliert.
# Absender-Postfach, z. B. ein gemeinsames Postfach in Microsoft 365
MAIL_ABSENDER=
# Variante A – Microsoft 365 / Outlook über Microsoft Graph (empfohlen), siehe docs/microsoft-entra-app-registrierung.md
MAIL_GRAPH_TENANT=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_SECRET=
# Rechnungseingang aus einem Postfach (Microsoft 365, App-Berechtigung Mail.ReadWrite)
RECHNUNGEN_POSTFACH=
# Variante B – beliebiger SMTP-Server, z. B. smtp://benutzer:passwort@smtp.example.de:587
MAIL_SMTP_URL=

# ---------------------------------------------------------------- Microsoft-Anmeldung (optional, ersetzt den Passwortschutz)
# Alle folgenden Werte setzen, dann:  docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# Zufallswert für die Sitzungsverschlüsselung:  openssl rand -base64 32
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<Verzeichnis-ID>/v2.0
# Rollen in der API prüfen
AUTH_AKTIV=false
# Caddy ohne Passwortschutz betreiben (erst umstellen, wenn die Anmeldung funktioniert)
CADDYFILE=Caddyfile
