{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Käuferportal: ohne Passwort erreichbar (Zugang über persönlichen Token-Link),
	# aber keine Server Actions über diesen Pfad – die Middleware der Weboberfläche prüft das zusätzlich.
	@portalaktion {
		path /portal /portal/*
		header Next-Action *
	}
	respond @portalaktion 403

	@intern not path /portal/* /_next/static/* /favicon.ico

	# Übergangsschutz, bis die Microsoft-Anmeldung eingebaut ist
	basic_auth @intern {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	request_body {
		max_size 30MB
	}

	reverse_proxy web:3000
}
